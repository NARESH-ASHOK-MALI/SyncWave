<ui:FluentWindow x:Class="SyncWave.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SyncWave.ViewModels"
        xmlns:utils="clr-namespace:SyncWave.Utils"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="SyncWave — One Sound. Many Devices." 
        Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/logo.png"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Auto">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- ───── OLED Color Palette (muted, no neon) ───── -->
        <Color x:Key="BgPrimary">#000000</Color>
        <Color x:Key="BgSecondary">#0A0A0A</Color>
        <Color x:Key="BgCard">#111111</Color>
        <Color x:Key="BgCardHover">#1A1A1A</Color>
        <Color x:Key="AccentPrimary">#B0B0B0</Color>
        <Color x:Key="AccentMuted">#808080</Color>
        <Color x:Key="AccentGreen">#5A9A5A</Color>
        <Color x:Key="AccentRed">#B05050</Color>
        <Color x:Key="AccentAmber">#A08040</Color>
        <Color x:Key="TextPrimary">#D4D4D4</Color>
        <Color x:Key="TextSecondary">#707070</Color>
        <Color x:Key="BorderSubtle">#1E1E1E</Color>

        <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimary}" />
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondary}" />
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCard}" />
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource AccentMuted}" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmber}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}" />

        <!-- ───── Converters ───── -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utils:StringToVisibilityConverter x:Key="StringToVisConverter" />
        <utils:LevelToWidthConverter x:Key="LevelToWidthConverter" />

        <!-- ═══════ CUSTOM SLIDER TEMPLATE ═══════ -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="500" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border x:Name="TrackBg" Height="3" CornerRadius="1.5"
                                    Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <!-- Filled portion -->
                            <Canvas ClipToBounds="True" VerticalAlignment="Center">
                                <Border x:Name="TrackFill" Height="3" CornerRadius="1.5"
                                        VerticalAlignment="Center"
                                        Canvas.Left="0" Canvas.Top="0"
                                        Background="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Canvas>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <!-- Thumb circle -->
                                                    <Ellipse x:Name="ThumbCircle" Width="12" Height="12"
                                                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="1.5" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="14" />
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="14" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider variant -->
        <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource ModernSlider}">
            <Setter Property="Maximum" Value="125" />
        </Style>

        <!-- ═══════ CARD BORDER (minimal) ═══════ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
        </Style>

        <!-- Device card item style -->
        <Style x:Key="DeviceCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════ STATUS PULSE ANIMATION ═══════ -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusPulse"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:1.5"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/logo.ico"
                        ToolTipText="SyncWave"
                        TrayLeftMouseUp="TrayIcon_TrayLeftMouseUp">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open SyncWave" Click="TrayIcon_Open_Click" />
                    <MenuItem Header="Exit" Click="TrayIcon_Exit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <ui:TitleBar Title="SyncWave" Grid.Row="0">
            <ui:TitleBar.Header>
                <Border CornerRadius="12" Padding="12,4" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Grid>
                            <Ellipse x:Name="StatusPulse" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.3" Fill="{Binding StatusBrush}" />
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding PlaybackStatus}" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="32" Height="32" 
                           Margin="0,0,10,0" VerticalAlignment="Center" 
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <TextBlock FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            SyncWave
                        </TextBlock>
                        <TextBlock Text="One Sound. Many Devices." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="10" Margin="0,-1,0,0" Opacity="0.8" />
                    </StackPanel>
                </StackPanel>

                <!-- Advanced Settings Toggle & Popup -->
                <ToggleButton x:Name="SettingsToggle" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" 
                              Background="Transparent" BorderThickness="0" Padding="8,6" ToolTip="Advanced Settings">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </ToggleButton>
                
                <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom" HorizontalOffset="-260" AllowsTransparency="True">
                    <Border Width="310" Margin="0" Padding="16" CornerRadius="12"
                            Background="#D90A0A0A" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="Advanced Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            
                            <ui:ToggleSwitch IsChecked="{Binding IsAudioBoostEnabled}" Content="Enable audio boost (up to 200%)" 
                                             Margin="0,0,0,8" VerticalAlignment="Center" />
                            <TextBlock Text="Allows individual devices to exceed 125% volume. Warning: may cause audio distortion." 
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ═══════════ LEFT PANEL — Device Selection ═══════════ -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <!-- Panel Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Audio Devices" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Select devices, then click Start Sync" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" 
                               Margin="0,3,0,0" />
                    <ui:Button Content="Refresh" Command="{Binding RefreshDevicesCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" 
                           TextWrapping="Wrap" 
                           FontSize="10" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           Margin="0,12,0,0">
                    <Run Text="Note: " FontWeight="Medium"/>
                    Hardware latency varies between devices (e.g., Bluetooth vs. Wired). If your devices are out of sync, find the device that plays sound first and increase its Delay until it perfectly matches the slower device.
                </TextBlock>

                <!-- Device List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DeviceCard}">
                                    <StackPanel>
                                        <!-- Device name + toggle row -->
                                        <DockPanel>
                                            <ui:ToggleSwitch IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0">
                                                <ui:ToggleSwitch.Style>
                                                    <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefaultDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:ToggleSwitch.Style>
                                            </ui:ToggleSwitch>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,2"
                                                    VerticalAlignment="Center" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                                <TextBlock Text="{Binding DeviceType}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           FontWeight="Medium" />
                                            </Border>
                                            <TextBlock Text="{Binding FriendlyName}" FontSize="13"
                                                       FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Status row -->
                                        <DockPanel Margin="48,4,0,0">
                                            <TextBlock FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDefaultDevice}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="Latency:" />
                                                <Run Text="{Binding MeasuredLatency, StringFormat='{}{0:F0}ms', Mode=OneWay}" 
                                                     Foreground="{StaticResource AccentPrimaryBrush}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>

                                        <!-- Controls (visible when selected AND not the default device) -->
                                        <StackPanel Margin="48,8,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                <Condition Binding="{Binding IsDefaultDevice}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            
                                            <!-- Volume slider -->
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock DockPanel.Dock="Left" Text="Vol" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Width="40" TextAlignment="Right"
                                                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"
                                                           FontWeight="Medium">
                                                    <Run Text="{Binding Volume, StringFormat='{}{0:F0}', Mode=OneWay}" />
                                                    <Run Text="%" />
                                                </TextBlock>
                                                <Slider Minimum="0" Maximum="{Binding DataContext.MaxVolumeLimit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Value="{Binding Volume}"
                                                        VerticalAlignment="Center" Margin="16,0" Style="{StaticResource VolumeSlider}" />
                                            </DockPanel>

                                            <!-- Delay slider -->
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock DockPanel.Dock="Left" Text="Delay" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Width="48"
                                                           Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center"
                                                           FontWeight="Medium" TextAlignment="Right">
                                                    <Run Text="{Binding ManualDelay, StringFormat='{}{0:F0}', Mode=OneWay}" />
                                                    <Run Text="ms" />
                                                </TextBlock>
                                                <Slider Minimum="0" Maximum="100"
                                                        Value="{Binding ManualDelay}"
                                                        VerticalAlignment="Center" Margin="16,0" Style="{StaticResource ModernSlider}" />
                                            </DockPanel>

                                            <!-- Buffer health bar -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="Buffer" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBlock DockPanel.Dock="Right" FontSize="10" Margin="6,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="{Binding BufferHealth, StringFormat='{}{0:F0}%', Mode=OneWay}" />
                                                </TextBlock>
                                                <Border CornerRadius="2" Background="{DynamicResource ControlFillColorDefaultBrush}" Height="4">
                                                    <Border CornerRadius="2" HorizontalAlignment="Left"
                                                            Width="{Binding BufferHealth, FallbackValue=0}"
                                                            Background="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Border.MaxWidth>
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=DockPanel}" />
                                                        </Border.MaxWidth>
                                                    </Border>
                                                </Border>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- Default device info (visible when is the default device) -->
                                        <Border Margin="48,4,0,0" Padding="10,8" CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefaultDevice}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontStyle="Italic">
                                                Always on — volume controlled via Windows.
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══════════ RIGHT PANEL — Controls & Monitoring ═══════════ -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Control Buttons ── -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Playback Control" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,3" />
                    <TextBlock Text="Play any audio on your system, then click Start Sync"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,12"
                               HorizontalAlignment="Center" />

                    <WrapPanel HorizontalAlignment="Center">
                        <ui:Button Content="Start Sync" Command="{Binding StartSyncCommand}"
                                Appearance="Primary" Margin="6" />
                        <ui:Button Content="Stop Sync" Command="{Binding StopSyncCommand}"
                                Appearance="Danger" Margin="6" />
                    </WrapPanel>

                    <!-- Error / info message -->
                    <Border CornerRadius="6" Margin="0,10,0,0" Padding="12,8"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                            BorderThickness="1" BorderBrush="#1E1414"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{StaticResource AccentRedBrush}"
                                   FontSize="11" TextWrapping="Wrap" FontWeight="Medium"
                                   HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Master Delay ── -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Master Delay Offset" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Width="55" TextAlignment="Right" 
                                   VerticalAlignment="Center" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource AccentPrimaryBrush}">
                            <Run Text="{Binding MasterDelayOffset, StringFormat='{}{0:F0}', Mode=OneWay}" />
                            <Run Text="ms" />
                        </TextBlock>
                        <Slider Minimum="0" Maximum="500" 
                                Value="{Binding MasterDelayOffset}"
                                VerticalAlignment="Center" Margin="16,0,12,0" Style="{StaticResource ModernSlider}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ── Waveform Visualization ── -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Waveform" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Audio level indicator -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Level " FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border CornerRadius="2" Background="{DynamicResource ControlFillColorDefaultBrush}" Height="6" Width="70"
                                    VerticalAlignment="Center">
                                <Border CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding AudioLevel, Converter={StaticResource LevelToWidthConverter}, FallbackValue=0}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#505050" Offset="0" />
                                            <GradientStop Color="#808080" Offset="0.7" />
                                            <GradientStop Color="#B05050" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Border CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="4" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="#111111">
                        <Canvas x:Name="WaveformCanvas" SizeChanged="WaveformCanvas_SizeChanged" />
                    </Border>
                </DockPanel>
            </Border>

            <!-- ── Monitoring Stats ── -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}">
                <UniformGrid Columns="3">
                    <!-- Active Devices -->
                    <StackPanel HorizontalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Active Devices" FontSize="9" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveDeviceCount}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Max Latency Diff -->
                    <StackPanel HorizontalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Max Latency Diff" FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Run Text="{Binding MaxLatencyDiff, StringFormat='{}{0:F1}', Mode=OneWay}" />
                            <Run Text="ms" FontSize="13" />
                        </TextBlock>
                    </StackPanel>
                    <!-- Status -->
                    <StackPanel HorizontalAlignment="Center" Margin="8,0">
                        <TextBlock Text="Status" FontSize="9"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PlaybackStatus}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding StatusBrush}" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- ═══════════ FOOTER ═══════════ -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="v1.1.0" FontSize="9"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Opacity="0.5" />
                <TextBlock FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                           Opacity="0.5">
                    <Run Text="SyncWave" FontWeight="Medium" />
                    <Run Text=" — System audio routed via WASAPI loopback. No kernel drivers required." />
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
    </Grid>
</ui:FluentWindow>
