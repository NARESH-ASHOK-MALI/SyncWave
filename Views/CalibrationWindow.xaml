<ui:FluentWindow x:Class="SyncWave.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SyncWave — Delay Calibration"
        Height="660" Width="520" MinHeight="550" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Icon="/Assets/logo.png"
        ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Auto">

    <Window.Resources>
        <!-- ───── Colors (matching MainWindow OLED palette) ───── -->
        <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#B0B0B0" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#5A9A5A" />
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#A08040" />
        <SolidColorBrush x:Key="AccentRedBrush" Color="#B05050" />

        <!-- Calibration slider (0-500ms range) -->
        <Style x:Key="CalibrationSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="500" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track background -->
                            <Border Height="4" CornerRadius="2"
                                    Background="{DynamicResource SurfaceStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="ThumbCircle" Width="16" Height="16"
                                                             Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                             Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        <Setter TargetName="ThumbCircle" Property="Width" Value="18" />
                                                        <Setter TargetName="ThumbCircle" Property="Height" Value="18" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Delay Calibration" Grid.Row="0" />

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,20">
            <StackPanel>
                
                <!-- ── Header ── -->
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Perceptual Delay Calibration" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Align devices by ear using an aperiodic click pattern" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>

                <!-- ── Reference Device Selector ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Reference Device" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Choose the fastest device (wired/USB). All other devices will be delayed to match this one."
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ComboBox x:Name="ReferenceDeviceCombo" DisplayMemberPath="FriendlyName"
                                  SelectionChanged="ReferenceDeviceCombo_SelectionChanged" />
                    </StackPanel>
                </Border>

                <!-- ── Device Queue ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Devices to Calibrate" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="DeviceQueueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="0,2" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding CalibrationStatusText}" FontSize="10"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FriendlyName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding DeviceType, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="Delay:" />
                                                    <Run Text="{Binding ManualDelay, StringFormat='{}{0:F0}ms', Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Active Calibration Panel ── -->
                <Border x:Name="CalibrationPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Current device info -->
                        <DockPanel Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="DeviceCountText" FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Medium" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Now Calibrating" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="CurrentDeviceName" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Codec estimate info -->
                        <Border x:Name="EstimateBadge" Padding="10,6" CornerRadius="6" Margin="0,0,0,12"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                            <TextBlock x:Name="EstimateText" FontSize="11" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Delay slider -->
                        <TextBlock Text="Delay Offset" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold" Width="80" TextAlignment="Right"
                                       Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center">
                                <Run x:Name="DelayValueText" Text="0" />
                                <Run Text="ms" FontSize="12" />
                            </TextBlock>
                            <Slider x:Name="DelaySlider" Style="{StaticResource CalibrationSlider}"
                                    ValueChanged="DelaySlider_ValueChanged" Margin="0,0,12,0" />
                        </DockPanel>

                        <!-- Alignment Preview -->
                        <Border Margin="0,8,0,12" Padding="12,10" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Alignment Preview" FontSize="10" FontWeight="Medium"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="(Visual guide only — not a measurement)" FontSize="9"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.6" Margin="0,0,0,8" />
                                
                                <!-- Reference device ticks -->
                                <TextBlock Text="Reference" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                <Canvas x:Name="ReferenceTickCanvas" Height="16" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
                                
                                <Rectangle Height="1" Fill="{DynamicResource SurfaceStrokeColorDefaultBrush}" Margin="0,4" />
                                
                                <!-- Target device ticks (shifted by delay) -->
                                <TextBlock Text="Target (with delay)" FontSize="9" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,2" />
                                <Canvas x:Name="TargetTickCanvas" Height="16" ClipToBounds="True"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Play/Stop + Confirm/Skip buttons -->
                        <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ui:Button x:Name="PlayStopButton" Content="▶ Play Clicks" Click="PlayStopButton_Click"
                                       Appearance="Primary" Margin="4" />
                            <ui:Button x:Name="ConfirmButton" Content="✓ Confirm" Click="ConfirmButton_Click"
                                       Appearance="Success" Margin="4" />
                            <ui:Button x:Name="SkipButton" Content="Skip →" Click="SkipButton_Click"
                                       Appearance="Secondary" Margin="4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── Status / Results ── -->
                <Border x:Name="StatusBorder" Style="{StaticResource CardBorder}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ── Action Buttons ── -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                    <ui:Button x:Name="StartButton" Content="Start Calibration" Click="StartButton_Click"
                               Appearance="Primary" Margin="4" />
                    <ui:Button Content="Close" Click="CloseButton_Click"
                               Appearance="Secondary" Margin="4" />
                </WrapPanel>

                <!-- Info panel -->
                <Border Padding="12,10" CornerRadius="8" Margin="0,12,0,0"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                    <TextBlock FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" LineHeight="16">
                        <Run Text="How it works:" FontWeight="SemiBold" /><LineBreak/>
                        An irregular click pattern plays on both the reference and target device simultaneously.
                        Adjust the delay slider until the clicks from both devices sound like a single, unified click.
                        The aperiodic pattern ensures there is only ONE correct alignment — unlike a regular beat,
                        which could falsely lock at multiples of the repeat interval.
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
